# Copy to .env.local (development) or set these in your hosting environment (production).

# The single admin account for /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-long-unique-password

# At least 16 characters; 32+ random ones are best, e.g. `openssl rand -hex 32`. Signs the login cookie.
SESSION_SECRET=

# --- Where content and uploaded images are stored ---------------------------------------------
# Option A (production): DigitalOcean Spaces with its CDN.
#   1. Create a Space and turn on its CDN (Spaces -> your Space -> Settings -> Content Delivery Network).
#   2. API -> Spaces Keys -> Generate New Key.
# Set the first four (and DO_SPACES_CDN_URL so images load from the CDN); leave ALL of them unset to use local disk.
# DO_SPACES_KEY=
# DO_SPACES_SECRET=
# DO_SPACES_BUCKET=your-space-name
# DO_SPACES_ENDPOINT=https://blr1.digitaloceanspaces.com
# DO_SPACES_REGION=blr1
# DO_SPACES_CDN_URL=https://your-space-name.blr1.cdn.digitaloceanspaces.com
# DO_SPACES_FOLDER=imt            # a folder inside the Space; everything for this site goes in it

# Option B: local disk (development, or a server with a persistent disk). Defaults to ./data
# DATA_DIR=/var/lib/imt
